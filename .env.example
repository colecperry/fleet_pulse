# HTTP server port
PORT=3000

# PostgreSQL connection string — format: postgres://user:password@host:port/dbname, default port is 5432
DATABASE_URL=postgres://fleet:fleet@localhost:5433/fleet_pulse

# Separate DB used only during integration tests — keeps test data out of dev DB
TEST_DATABASE_URL=postgres://fleet:fleet@localhost:5433/fleet_pulse_test

# Kafka broker address — host:port, default is localhost:9092
KAFKA_BROKER=localhost:9092

# How often the simulator publishes a telemetry event per vehicle (milliseconds)
SIMULATOR_INTERVAL_MS=1000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_DB=fleet_pulse
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
