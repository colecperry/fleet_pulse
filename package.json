{
  "name": "fleet-pulse",
  "version": "1.0.0",
  "description": "Real-time fleet telemetry pipeline with Kafka, Flink, PostgreSQL, and MCP server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "simulate": "ts-node src/simulator.ts",
    "consume": "ts-node src/consumer.ts",
    "migrate": "ts-node src/migrate.ts",
    "start:all": "concurrently \"npm run dev\" \"npm run consume\" \"npm run simulate\"",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "concurrently": "^10.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
