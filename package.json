{
  "name": "fleet-pulse",
  "version": "1.0.0",
  "description": "Real-time fleet telemetry pipeline with Kafka, Flink, PostgreSQL, and MCP server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "simulate": "ts-node src/simulator.ts",
    "consume": "ts-node src/consumer.ts",
    "migrate": "ts-node src/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
